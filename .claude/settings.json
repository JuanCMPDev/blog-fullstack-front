{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ls*)",
      "Bash(npm outdated*)",
      "Bash(npm audit*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx next *)",
      "Bash(npx vitest *)",
      "Bash(npx jest *)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma validate*)",
      "Bash(npx prisma format*)",
      "Bash(./node_modules/.bin/*)",
      "Bash(node *)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(wc *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git revert *)",
      "Bash(git worktree *)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(git push -u origin relaunch/*)",
      "Bash(git push origin relaunch/*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git push origin develop*)",
      "Bash(git push -u origin main*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(rm -rf *)",
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma migrate deploy*)",
      "Bash(npx prisma db push*)",
      "Bash(npx prisma db execute*)"
    ]
  }
}
